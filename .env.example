# BullVerse — variáveis de ambiente (Vite)
# Copie para `.env.local` e ajuste.

# URL base da API REST (sem barra final).
# Vazio = frontend usa mocks locais (desenvolvimento sem backend).
VITE_API_BASE_URL=

# Force mocks mesmo com URL (`true`) ou force HTTP (`false`).
# Omitido: mocks se VITE_API_BASE_URL estiver vazio.
# VITE_USE_MOCKS=true

# Exemplos:
# VITE_API_BASE_URL=http://localhost:3000
# VITE_USE_MOCKS=false
